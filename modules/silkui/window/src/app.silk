//! A Loom app in a window: what the host silkui generates for a Loom app runs. The app's
//! model `P` is a `Program<M, C>`; its commands may ask the window's [`Shell`] for things.
//!
//! ```silk,ignore
//! import project.app { Model, Message }
//! import silkui_window_loom.app { Settings, main as loom }
//!
//! pub fn main() -> i32 {
//!   return loom<Model, Message>(Settings { title: "My app", width: 900.0, height: 600.0, inspect: true })
//! }
//! ```
import loom.app { NoCommand }
import loom.program { Program, CommandSet }
import loom.shell { Shell }
import loom_window.program { Launched, Window, StyleAssets, launch, show, systemFonts, failed }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// The window an app opens, and whether a debug build serves the inspector when
/// `SILK_UI_INSPECT` is set (the development host) or never does (the release host).
pub struct Settings {
  pub title: string<'static>,
  pub width: f64,
  pub height: f64,
  pub inspect: bool,
}

impl Copy for Settings {}

effect fn window(settings: Settings, sheets: StyleAssets) -> Window ! OutOfMemoryError ? &mut Allocator {
  let mut window = run Window.make(settings.title, settings.width, settings.height)
  window.withStyleSheets(move sheets)
  if !settings.inspect { window.uninspected() }
  return move window
}

effect fn opened<P: Program<M, NoCommand>, M>(settings: Settings, platform: Option<Launched>, sheets: StyleAssets) -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let fonts = run systemFonts()
  return run show<P, M, NoCommand, never>(run window(settings, move sheets), &fonts, move platform)
}

effect fn openedWithCommands<P: Program<M, C>, M, C: CommandSet<M, &mut Shell | &mut Allocator>>(settings: Settings, platform: Option<Launched>, sheets: StyleAssets) -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let window = run window(settings, move sheets)
  let mut shell = window.shell()
  let fonts = run systemFonts()
  return run show<P, M, C, &mut Shell | &mut Allocator>(move window, &fonts, move platform)
    |> Effect.provideMut<Shell>(&mut shell)
}

fn app<P: Program<M, NoCommand>, M>(settings: Settings, platform: Option<Launched>, sheets: StyleAssets) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(opened<P, M>(settings, move platform, move sheets), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

fn appWithCommands<P: Program<M, C>, M, C: CommandSet<M, &mut Shell | &mut Allocator>>(settings: Settings, platform: Option<Launched>, sheets: StyleAssets) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(openedWithCommands<P, M, C>(settings, move platform, move sheets), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

/// The host's main for an app without commands.
pub fn main<P: Program<M, NoCommand>, M>(settings: Settings) -> i32 {
  return mainWithSheets<P, M>(settings, &[])
}

/// Starts with build-compiled application sheets, in adoption order.
pub fn mainWithSheets<P: Program<M, NoCommand>, M>(settings: Settings, sources: &[&[u8]]) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(launchSheets<P, M>(settings, sources), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn launchSheets<P: Program<M, NoCommand>, M>(settings: Settings, sources: &[&[u8]]) -> i32
  ! OutOfMemoryError ? &mut Allocator {
  let sheets = run StyleAssets.from(sources)
  // Copy borrowed source bytes before transferring them to the app thread.
  return launch(fn(platform: Option<Launched>) -> i32 {
    return app<P, M>(settings, move platform, move sheets)
  })
}

/// Main for an app whose commands may ask the window's Shell for things.
pub fn withCommands<P: Program<M, C>, M, C: CommandSet<M, &mut Shell | &mut Allocator>>(settings: Settings) -> i32 {
  return withCommandsAndSheets<P, M, C>(settings, &[])
}

pub fn withCommandsAndSheets<P: Program<M, C>, M, C: CommandSet<M, &mut Shell | &mut Allocator>>(
  settings: Settings, sources: &[&[u8]],
) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(launchCommandsAndSheets<P, M, C>(settings, sources), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn launchCommandsAndSheets<P: Program<M, C>, M, C: CommandSet<M, &mut Shell | &mut Allocator>>(
  settings: Settings, sources: &[&[u8]],
) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let sheets = run StyleAssets.from(sources)
  return launch(fn(platform: Option<Launched>) -> i32 {
    return appWithCommands<P, M, C>(settings, move platform, move sheets)
  })
}
